# Hybrid / Docker-ready profile (infra may run in containers or native services)
APP_ENV=dev
RUNTIME_MODE=hybrid

# Database/cache
DATABASE_URL=postgresql+psycopg2://tgg:tgg@postgres:5432/tgg
REDIS_URL=redis://redis:6379/0

# Ingestion scope (comma-separated symbols)
WATCHLIST=AAPL,MSFT,TSLA,BTC-USD

# Optional Telegram integration (disabled unless all 3 values are configured)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_TELEGRAM=false

# Safety defaults: live OFF, kill-switch ON, two-step approval ON.
ENABLE_LIVE_TRADING=false
REQUIRE_TWO_STEP_APPROVAL=true
KILL_SWITCH=true

# Risk controls
MAX_RISK_PER_TRADE_PCT=0.01
MAX_DAILY_DRAWDOWN_PCT=0.03
MAX_OPEN_POSITIONS=10
