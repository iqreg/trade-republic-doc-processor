# Native mode (macOS preferred for first real testing)
APP_ENV=native
RUNTIME_MODE=native

# Lightweight native defaults (no Docker required)
DATABASE_URL=sqlite:///./tgg_native.db
REDIS_URL=
WATCHLIST=AAPL,MSFT,TSLA

# Telegram optional
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Safety defaults (must remain conservative)
ENABLE_LIVE_TRADING=false
REQUIRE_TWO_STEP_APPROVAL=true
KILL_SWITCH=true
